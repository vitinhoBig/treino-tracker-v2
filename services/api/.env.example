# Copy to services/api/.env. Server-side only. Real values are never committed.
# SUPABASE_URL is read now, to verify tokens. The rest arrive with the features that use them.
# Write it exactly as `npx supabase status` shows it. Tokens carry this URL as their issuer, so
# http://localhost:54321 would make every local token fail verification.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
USDA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
