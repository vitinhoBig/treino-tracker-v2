-- Shared test data. Each test file includes this with `\ir helpers/fixtures.psql`. The .psql extension
-- stops the test runner from treating it as a test, and everything rolls back with the test's transaction.
--
-- Personas: owner shares with one viewer at each tier, and stranger has no connection to anyone.

create schema tests;
grant usage on schema tests to anon, authenticated;

create function tests.uid(p_name text) returns uuid language sql immutable as $$
  select (case p_name
    when 'owner'    then 'a0000000-0000-4000-8000-000000000001'
    when 'viewer_w' then 'a0000000-0000-4000-8000-000000000002'
    when 'viewer_b' then 'a0000000-0000-4000-8000-000000000003'
    when 'viewer_e' then 'a0000000-0000-4000-8000-000000000004'
    when 'stranger' then 'a0000000-0000-4000-8000-000000000005'
  end)::uuid;
$$;

-- Switch identity the same way PostgREST does: a role plus JWT claims.
create function tests.as_user(p_name text) returns void language plpgsql as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', json_build_object('sub', tests.uid(p_name), 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end $$;

create function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '', true);
  perform set_config('role', 'anon', true);
end $$;

create function tests.as_admin() returns void language plpgsql as $$
begin
  perform set_config('role', 'none', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

-- Switch to a persona by name, including anon.
create function tests.become(p_persona text) returns void language plpgsql as $$
begin
  if p_persona = 'anon' then perform tests.as_anon(); else perform tests.as_user(p_persona); end if;
end $$;

grant execute on all functions in schema tests to anon, authenticated;

insert into auth.users (id, email, raw_user_meta_data)
select tests.uid(n), n || '@example.test', json_build_object('display_name', n)::jsonb
from unnest(array['owner', 'viewer_w', 'viewer_b', 'viewer_e', 'stranger']) as n;

insert into public.shares (owner_id, viewer_id, scope, status) values
  (tests.uid('owner'), tests.uid('viewer_w'), 'workouts', 'active'),
  (tests.uid('owner'), tests.uid('viewer_b'), 'workouts_and_body', 'active'),
  (tests.uid('owner'), tests.uid('viewer_e'), 'everything', 'active');

