# Copy to apps/mobile/.env. Everything prefixed EXPO_PUBLIC_ ships inside the app and anyone can
# read it, so never put a secret here. Server secrets belong in services/api/.env.
# None of these are read yet: they arrive with sign-in and the API client.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
