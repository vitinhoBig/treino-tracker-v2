# Copy to apps/mobile/.env. Everything prefixed EXPO_PUBLIC_ ships inside the app and anyone can
# read it, so never put a secret here. Server secrets belong in services/api/.env.
# Read by src/lib/config.ts. While developing, a 127.0.0.1 or localhost URL is automatically pointed at
# your laptop's address when the app runs on a phone, so keep these as they are. Real hosts are left alone.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
